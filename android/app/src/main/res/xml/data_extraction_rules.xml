<?xml version="1.0" encoding="utf-8"?>
<!--
  DOMUX no copia sus datos a la nube de Google ni a otro celular (Android 12 o más nuevo):
  la sesión, lo temporal y las cuentas recordadas en el inicio de sesión se quedan solo en este
  celular. La sesión y lo temporal se borran al cerrar sesión; cada cuenta recordada se quita con
  su X en el inicio de sesión.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
