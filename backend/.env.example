# Variables de entorno del servidor de DOMUX.
# Copia este archivo como ".env" (sin ".example") y escribe tus propios valores.
# El archivo .env nunca se sube a GitHub. En Render, estas variables se ponen en
# el grupo de variables del servicio.

# Clave que firma los tokens de sesión: larga y al azar, de 64 caracteres.
# Se puede crear con: python -c "import secrets; print(secrets.token_hex(32))"
# En producción es obligatoria; en desarrollo, si falta, se usa una temporal.
JWT_SECRET=

# Dirección de la base de datos. Si no se define, se usa SQLite (domux.db).
# Ejemplo: postgresql://usuario:clave@localhost:5432/domux
DATABASE_URL=

# Contraseñas de las cuentas de prueba (mínimo 8 caracteres, con mayúscula,
# minúscula, número y símbolo). En desarrollo, si faltan, se crean al azar y se
# guardan en backend/instance/demo_credentials.txt. Si cambias una, el servidor
# la aplica al reiniciar.
SEED_ADMIN_PASSWORD=
SEED_GUARD_PASSWORD=
SEED_RESIDENT_PASSWORD=

# Páginas web de otro dominio que pueden llamar a la API, separadas por comas.
# Déjala vacía: la app Android y la web de administración no la necesitan.
CORS_ORIGINS=

# Clave de la cuenta de servicio de Firebase (todo el contenido del archivo JSON)
# para enviar avisos al celular. Sin ella el servidor funciona, sin avisos.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Producción fuera de Render: APP_ENV=production. Depuración local: FLASK_DEBUG=1.
APP_ENV=
FLASK_DEBUG=
LOG_LEVEL=INFO
