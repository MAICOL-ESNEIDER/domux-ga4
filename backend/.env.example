# Variables de entorno del servidor de DOMUX.
# Copia este archivo como ".env" (sin ".example") y escribe tus propios valores.
# El archivo .env nunca se sube a GitHub. En Render, estas variables se ponen en
# el grupo de variables del servicio.

# Clave que firma los tokens de sesión: larga y al azar, de 64 caracteres.
# Se puede crear con: python -c "import secrets; print(secrets.token_hex(32))"
# En producción es obligatoria; en desarrollo, si falta, se usa una temporal.
JWT_SECRET=

# Dirección de la base de datos. Si no se define, se usa SQLite (domux.db).
# Ejemplo: postgresql://usuario:clave@localhost:5432/domux
DATABASE_URL=

# Contraseñas de las cuentas de prueba, una por rol (mínimo 8 caracteres, con
# mayúscula, minúscula, número y símbolo): la de administración, la de los 4
# guardias y la de los 12 residentes. En desarrollo, si faltan, se crean al azar
# y se guardan en backend/instance/demo_credentials.txt. Si cambias una, el
# servidor la aplica al reiniciar a todas las cuentas de prueba de ese rol.
SEED_ADMIN_PASSWORD=
SEED_GUARD_PASSWORD=
SEED_RESIDENT_PASSWORD=

# Páginas web de otro dominio que pueden llamar a la API, separadas por comas.
# Déjala vacía: la app Android y la web de administración no la necesitan.
CORS_ORIGINS=

# Clave de la cuenta de servicio de Firebase (todo el contenido del archivo JSON)
# para enviar avisos al celular. Sin ella el servidor funciona, sin avisos.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Copias de seguridad de la base de datos (scripts/copia_diaria.py). Solo para PostgreSQL.
# BACKUP_DIR: carpeta donde se guardan las copias. De preferencia un disco o USB distinto al
# del computador y NUNCA dentro del proyecto (las copias llevan datos reales). Ejemplo: E:\copias_domux
BACKUP_DIR=
# BACKUP_KEEP: cuántas copias se conservan (las más nuevas). Si se deja vacío, 7.
BACKUP_KEEP=
# PG_BIN_DIR: carpeta de pg_dump y pg_restore, solo si no están en el PATH.
# Ejemplo: C:\Program Files\PostgreSQL\16\bin
PG_BIN_DIR=

# Producción fuera de Render: APP_ENV=production. Depuración local: FLASK_DEBUG=1.
APP_ENV=
FLASK_DEBUG=
LOG_LEVEL=INFO

# Opcionales: ya tienen un valor por defecto. Quita el "#" de la línea para cambiarlo.
# Puerto del servidor (Render lo define solo).
# PORT=5000
# Días que un vehículo visitante puede quedarse en la unidad.
# VISITOR_PARKING_MAX_DAYS=3
# Otra forma de dar la cuenta de servicio de Firebase: la ruta del archivo JSON en este
# equipo. Si ya llenaste FIREBASE_SERVICE_ACCOUNT_JSON, no hace falta.
# GOOGLE_APPLICATION_CREDENTIALS=
