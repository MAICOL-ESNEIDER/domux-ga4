# Copia este archivo a ".env" (sin ".example") y ajusta los valores si quieres.
# En local NO es obligatorio crearlo: sin él, la app usa SQLite y una clave de
# desarrollo por defecto (ver auth.py). En Render, estas variables las pone
# render.yaml automáticamente.

# Clave secreta para firmar los tokens JWT. En producción SIEMPRE debe ser
# un valor largo y aleatorio (Render la genera solo con "generateValue: true").
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# URL de la base de datos. Si no se define, se usa SQLite local (domux.db).
# En Render, Render la inyecta automáticamente apuntando a la base Postgres.
# DATABASE_URL=postgresql://usuario:clave@host:5432/nombre_db

# Puerto en el que corre el servidor (Render lo define solo).
PORT=5000
